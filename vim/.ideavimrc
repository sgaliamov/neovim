source ~/.vimrc

" noremap <leader>f <Action>(ReformatCode)

" " todo: support all arrows and visual mode
" " inoremap <silent> <expr> <S-Right> (col('.') == 1 ? '<Esc>v/[^a-z]<CR><Left>' : '<Esc><Right>v/[^a-z]<CR><Left>')
noremap <S-End> <Esc>v$
noremap <S-Home> <Esc>v^


" set commentary

" need `IdeaVim-EasyMotion`, `AceJump`
set easymotion
map ; <Plug>(easymotion-prefix)
map ;; <Plug>(easymotion-s)

set highlightedyank
" set NERDTree
" set surround

" need Which-Key
set which-key
set timeoutlen=10000

" need `IdeaVimExtension` plugin to support this
set keep-english-in-normal-and-restore-in-insert
