source ~/.vimrc

" ========= ReSharper Mappings (enable if you use ReSharper) =========
" Uncomment as needed
" nnoremap  <leader>rr :vsc ReSharper.ReSharper_Rename<CR>
" nnoremap  <leader>fu :vsc ReSharper.ReSharper_FindUsages<CR>
" nnoremap  <leader>cc :vsc ReSharper.ReSharper_SilentCleanupCode<CR>
" nnoremap  <leader>gd :vsc ReSharper.ReSharper_GotoDeclaration<CR>
" nnoremap  <leader>gi :vsc ReSharper.ReSharper_GotoImplementation<CR>
" nnoremap  <leader>xt :vsc ReSharper.ReSharper_InspectThis<CR>

" ========= Core Visual Studio Navigation / Editing =========
" Go to definition / peek
nnoremap  gd :vsc Edit.GoToDefinition<CR>
nnoremap  gD :vsc Edit.PeekDefinition<CR>
" Find all references
nnoremap  gr :vsc Edit.FindAllReferences<CR>
" Format document
nnoremap  = :vsc Edit.FormatDocument<CR>
" Toggle line comment
nnoremap  gc :vsc Edit.LineComment<CR>
" Toggle block comment
nnoremap  gb :vsc Edit.BlockComment<CR>

" ========= Debugging =========
nnoremap  <leader>ds :vsc Debug.Start<CR>
nnoremap  <leader>dS :vsc Debug.StopDebugging<CR>
nnoremap  <leader>dv :vsc Debug.StepOver<CR>
nnoremap  <leader>dn :vsc Debug.StepInto<CR>
nnoremap  <leader>do :vsc Debug.StepOut<CR>
nnoremap  <leader>db :vsc Debug.ToggleBreakpoint<CR>

" ========= Motion / Navigation Enhancements =========
" Whole viewport jump-to-word (PeasyMotion)
nnoremap  WW gS:vsc Tools.InvokePeasyMotion<CR>
nnoremap  Ww gS:vsc Tools.InvokePeasyMotion<CR>
" Select to motion target
nmap  WV gS:vsc Tools.InvokePeasyMotionTextSelect<CR>
nmap  Wv gS:vsc Tools.InvokePeasyMotionTextSelect<CR>

" Buffer/document switching
nnoremap  <leader>bn :vsc Window.NextDocumentWindow<CR>
nnoremap  <leader>bp :vsc Window.PreviousDocumentWindow<CR>

" ========= Line Movement (uncomment if not conflicting with VS) =========
" nnoremap <A-j> :vsc Edit.MoveSelectedLinesDown<CR>
" nnoremap <A-k> :vsc Edit.MoveSelectedLinesUp<CR>
" vnoremap <A-j> :vsc Edit.MoveSelectedLinesDown<CR>gv
" vnoremap <A-k> :vsc Edit.MoveSelectedLinesUp<CR>gv

" ========= Saving =========
" Visual Studio may intercept <C-s>; ensure no conflicting VS shortcut is blocking VsVim.
" Normal mode save all
nnoremap  <C-s> :vsc File.SaveAll<CR>
" Insert mode save all (returns to insert)
inoremap  <C-s> <Esc>:vsc File.SaveAll<CR>a
" Visual mode save then reselect
vnoremap  <C-s> <Esc>:vsc File.SaveAll<CR>gv

" ========= Window / Pane Management =========
" Close current document
nnoremap  <leader>q :vsc File.Close<CR>
" Move between split tool windows (if you use them)
nnoremap  <leader><Left>  :vsc Window.ActivatePreviousDocumentWindow<CR>
nnoremap  <leader><Right> :vsc Window.ActivateNextDocumentWindow<CR>

" ========= Reload Config =========
nnoremap  <leader>vr :so ~/.vsvimrc<CR>:echo "VsVim config reloaded"<CR>

" ========= Search Helpers =========
" Clear search highlight quickly
nnoremap  <leader>/ :nohlsearch<CR>

" ========= Experimental / Reference =========
" Peek references (alternative)
" nnoremap  <leader>pr :vsc Edit.PeekReferences<CR>
" Quick launch (if you free F1)
nnoremap  <F1> :vsc Help.QuickLaunch<CR>
