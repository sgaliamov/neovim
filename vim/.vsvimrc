source ~/.vimrc

" nvim and vscode have it by default, but visual studio does not
set hlsearch
set incsearch
set number
set relativenumber

" " ============ RESHARPER ==============

" " noremap <leader>rr :vsc ReSharper.ReSharper_Rename<CR>

" " Format and cleanup
" noremap <leader>f :vsc ReSharper.ReSharper_SilentCleanupCode<CR>==

" " Comment line
" noremap gc :vsc ReSharper.ReSharper_LineComment<CR>==

" " Comment block
" noremap gb :vsc ReSharper.ReSharper_BlockComment<CR>==

" " go to sources (Ctrl-F12)
" noremap gs :vsc Edit.GoToDeclaration<CR>

" " show references (Shift-F12)
" noremap gr :vsc ReSharper.ReSharper_FindUsages<CR>

" " =========== VISUAL STUDIO ===========

" " Enforse `dd` as other bindings make it slow
" nnoremap dd dd

" " Start debugging
" nnoremap ds :vsc Debug.Start<CR>

" " Stop debugging
" nnoremap dS :vsc Debug.StopDebugging<CR>

" " Step over
" nnoremap dv :vsc Debug.StepOver<CR>

" " Step into
" nnoremap dn :vsc Debug.StepInto<CR>

" " Step out
" nnoremap do :vsc Debug.StepOut<CR>

" " Toggle breakpoint
" nnoremap db :vsc Debug.ToggleBreakpoint<CR>

" noremap <A-j> :vsc Edit.MoveSelectedLinesDown<CR>
" noremap <A-k> :vsc Edit.MoveSelectedLinesUp<CR>

" "Whole viewport jump-to-word beginning mode:
" nnoremap WW gS:vsc Tools.InvokePeasyMotion<CR>
" nnoremap Ww gS:vsc Tools.InvokePeasyMotion<CR>

" "Select text from current caret position to desired jump label (fwd and reverse directions supported)
" nmap WV gS:vsc Tools.InvokePeasyMotionTextSelect<CR>
" nmap Wv gS:vsc Tools.InvokePeasyMotionTextSelect<CR>

" " Reload vim config.
" nnoremap <leader>zl :so ~/.vsvimrc<CR>

" " <C-o> in insert mode temprarly switches to nomal mode, therefore it should not be remaped
" noremap <leader>o <Esc>:vsc File.OpenFile<CR>

" " DON'T WORK:

" " does not work, disable vsvim handler.
" " noremap <C-s>:vsc File.SaveAll<CR>
" " inoremap <C-s>:vsc File.SaveAll<CR>

" " Use F1 as C-p is used in vscode for autocomplete
" " does not work, configure regular shortcut
" " noremap <F1>:vsc Window.QuickLaunch<CR>

" " TBD:

" " Ctrl-Alt-Right
" " noremap <leader>w :vsc ReSharper.ReSharper_ExtendSelection<CR>
" " nnoremap <leader>o <Esc>:vsc File.OpenFile<CR>
" " inoremap <C-f> <Esc>:vsc Edit.Find<CR>

" " show definition in popup window
" " noremap gD :vsc Edit.PeekDefinition<CR>

" " " Copy selected text in the visual mode
" " vnoremap <C-c> y

" " " Copy a line in the normal mode
" " nnoremap <C-c> yy

" " " Close window
" " nnoremap <C-w><C-q> :clo<CR>

" " nnoremap <leader>zk :vsc Tools.CustomizeKeyboard<CR>

" " try https://github.com/VsVim/VsVim/blob/master/Documentation/CSharp%19scripting.md
" " https://github.com/keithn/vsvimguide

" " https://github.com/neovim/nvim-lspconfig?tab=readme-ov-file#suggested-configuration inspiration for key bindings
" " https://github.com/vscode-neovim/vscode-neovim?tab=readme-ov-file#code-navigation
